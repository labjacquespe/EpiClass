# Justfile for managing test suite with multiple Python versions.
# Uses `uv` (https://pypi.org/project/uv/) for environment and dependency management.
# Uses `pytest` for running tests.

# List all available recipes
list:
    @just --list
    @echo "Use 'just <recipe>' to run a specific recipe."

# Generate timestamp for log files
_timestamp := `date +"%Y%m%d_%H%M%S"`

# Do not use relative paths. Always resolve from git root to ensure consistent behavior regardless of where just is invoked.
git_root := `git rev-parse --show-toplevel`

# Environment check
check-env:
    @echo "🔍 Checking environment..."
    @which uv > /dev/null || (echo "❌ uv not found" && exit 1)
    @echo "✅ Environment OK"

# Compile requirements for a specific Python version (separate step for reproducibility)
compile python_version:
    #!/usr/bin/env bash
    set -euo pipefail
    v="{{python_version}}"
    timestamp="{{_timestamp}}"
    git_root="{{git_root}}"
    log="logs/${timestamp}_py${v}_1-compile.log"
    echo "📋 Compiling requirements for Python ${v}..."

    # Ensure requirements are compatible with the specified Python version
    # Will fail if not compatible
    uv pip compile -p=${v} ${git_root}/src/python/requirements/req_core.in &>> $log
    uv pip compile -p=${v} ${git_root}/src/python/pyproject.toml --extra=test &>> $log

    echo "✅ Requirements compiled for Python ${v} - No conflict"

# Run tests for a specific Python version using pre-compiled requirements
# Optional: pass test_filter to select specific tests (e.g., just test 3.11 "test_foo")
test python_version test_filter="":
    #!/usr/bin/env bash
    set -euo pipefail

    mkdir -p logs
    mkdir -p envs

    git_root="{{git_root}}"
    python_dir="${git_root}/src/python"
    test_dir="${python_dir}/tests"

    # parameters
    v="{{python_version}}"
    test_filter="{{test_filter}}"

    # files
    venv_path="./envs/venv_test_${v}"
    req_file="${python_dir}/requirements/req_test_${v}.txt"

    timestamp="{{_timestamp}}"
    log_install="logs/${timestamp}_py${v}_2-install.log"
    log_pytest="logs/${timestamp}_py${v}_3-pytest.log"

    echo "🚀 Starting test sequence for Python ${v}..."
    echo "📝 Logs will be saved with timestamp: ${timestamp}"

    # Ensure requirements are compatible with the specified Python version
    just compile ${v}

    # Create fresh virtual environment (--clear removes existing one)
    echo "🔄 Creating fresh virtual environment for Python ${v}..."
    uv venv --seed --clear -p=${v} "$venv_path"
    . "$venv_path/bin/activate"

    echo "📦 Installing package with test dependencies..."
    python ${git_root}/install.py test --freeze $req_file &>> $log_install

    echo "🧪 Running pytest for Python ${v}..."
    if [ -n "$test_filter" ]; then
        echo "🔍 Filtering tests with: -k '$test_filter'"
        pytest --tb=short -k "$test_filter" ${test_dir} &>> $log_pytest || true
    else
        pytest --tb=short ${test_dir} &>> $log_pytest || true
    fi

    # Optionally filter out known benign warnings "i" for in-place edit
    del_str="[LightGBM] [Warning] No further splits with positive gain, best gain: -inf"
    sed -i "/$del_str/d" "$log_pytest" || true

    echo "✅ Tests for Python ${v} completed"
    grep -E '[0-9]+ (passed|failed|skipped)' $log_pytest || true
    echo "check logs/ directory for detailled results."

# Compile requirements for all Python versions
compile-all: check-env
    just compile 3.10
    just compile 3.11
    just compile 3.12
    @echo "✅ All requirements compiled"

# Run all tests in parallel for all Python versions
test-all test_filter="": check-env
    #!/usr/bin/env bash
    set -euo pipefail

    timestamp="{{_timestamp}}"
    echo "🕒 Global run timestamp: ${timestamp}"
    mkdir -p logs

    versions=(3.10 3.11 3.12)
    pids=()

    for v in "${versions[@]}"; do
        echo "▶ Starting tests for Python ${v} (no console output, check logs)..."
        # Silence test output entirely except for the overview log
        just test "$v" "{{test_filter}}" \
            &> "logs/${timestamp}_py${v}_0-overview.log" &
        pids+=($!)
    done

    echo "🏃 Running tests in parallel..."
    exit_code=0
    for pid in "${pids[@]}"; do
        if ! wait "$pid"; then
            exit_code=1
        fi
    done

    echo
    echo "📊 Final summary"
    echo "----------------------------------------"
    for v in "${versions[@]}"; do
        # find pytest log produced inside `just test`
        log_file=$(ls logs/${timestamp}*${v}*pytest.log 2>/dev/null | sort | tail -n 1 || true)
        if [ -n "$log_file" ]; then
            summary=$(grep -E '[0-9]+ (passed|failed|skipped)' "$log_file" | tail -n 1 || true)
            if [ -n "$summary" ]; then
                printf "Python %-5s → %s\n" "$v" "$summary"
            else
                printf "Python %-5s → (no summary found, see %s)\n" "$v" "$log_file"
            fi
        else
            printf "Python %-5s → (no pytest log found)\n" "$v"
            printf "Tried to find: logs/${timestamp}*${v}*pytest.log\n"
        fi
    done
    echo "----------------------------------------"
    echo

    if [ $exit_code -eq 0 ]; then
        echo "✅ All test runs succeeded."
    else
        echo "❌ One or more test runs failed. Check logs/ for details."
    fi

    exit $exit_code

# Clean up generated files (WARNING: deletes all logs!)
clean:
    #!/usr/bin/env bash
    echo "⚠️  This will delete ALL log files and cache directories!"
    echo "Press Ctrl+C to cancel, or Enter to continue..."
    read -r
    echo "🧹 Cleaning up..."
    for dir in logs envs ./venv __pycache__ .pytest_cache; do
        if [ -d "$dir" ]; then
            echo "Removing $dir..."
            rm -rf "$dir"
        fi
    done
    echo "✅ Cleanup complete"
